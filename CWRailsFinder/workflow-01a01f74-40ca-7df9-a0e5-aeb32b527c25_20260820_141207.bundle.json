wUuAA7ifchx7Q3xVULPWvQPW19bU","fields":{"humanSecondsSaved":0,"notes":[],"output":[{"findings_json":"{{ CTX.audit.findings | to_json_string }}"},{"rails_tasks":"{{ CTX.audit.total }}"},{"truncated":"{{ CTX.audit.truncated }}"},{"workflows_affected":"{{ CTX.audit.workflows }}"},{"writes":"{{ CTX.audit.writes }}"}],"parameters":{"task_limit":{"type":"integer","default":"{{ 1000 }}","required":false,"multiline":false}},"tasks":[{"id":"@@@workflow_task_id_ref1@@@","input":{},"join":1,"retry":null,"mockInput":{},"isMocked":false,"humanSecondsSaved":0,"timeout":600,"transitionMode":"FOLLOW_FIRST","publishResultAs":null,"runAsOrgId":null,"with":null,"securitySchema":{},"action":{"id":"@@@action_ref1@@@"},"next":[{"do":["@@@workflow_task_id_ref5@@@"],"id":"@@@transition_id_ref1@@@","publish":[],"when":"{{ SUCCEEDED }}"}],"packOverrides":[]},{"id":"@@@workflow_task_id_ref2@@@","input":{"params":{"text":"{%- set findings = [] -%}\n{%- set sweeps = [\n  {\"action\": \"cw_manage.generic_request\", \"field\": \"url_path\", \"tasks\": CTX.cw_tasks or []},\n  {\"action\": \"core.http_request\", \"field\": \"url\", \"tasks\": CTX.http_tasks or []}\n] -%}\n{%- for sweep in sweeps -%}\n{%- for t in sweep.tasks -%}\n{%- set inp = t.input or {} -%}\n{%- set raw = (inp.get(sweep.field) or '') | string -%}\n{%- set probe = raw | lower -%}\n{%- if '.rails' in probe or 'system_io' in probe or 'actionprocessor' in probe -%}\n{%- set clean = raw | replace('\\r', ' ') | replace('\\n', ' ') | trim -%}\n{%- set segs = [s for s in clean.split('?')[0].split('/') if s] -%}\n{%- set leaf = (segs[-1] if segs else '') | replace('.rails', '') -%}\n{%- set lw = leaf | lower -%}\n{%- set loop_cfg = t['with'] or {} -%}\n{%- set wf = t.workflow or {} -%}\n{#- Every rails call is POST, so the HTTP method says nothing about whether it\n    reads or writes. The CW action class name does: GetMultilineDataAction is a\n    read, SaveServiceTicketFinanceBillingPodAction is a write.\n    Kept as ONE expression on purpose - a `set` inside a `for` loop does not\n    escape the loop scope in Jinja, so a prefix loop here silently always\n    returns the fallback. -#}\n{%- set is_read = lw.startswith('get') or lw.startswith('list') or lw.startswith('load') or lw.startswith('fetch') or lw.startswith('retrieve') or lw.startswith('find') or lw.startswith('search') -%}\n{%- do findings.append({\n  \"org_id\": wf.get('orgId') or '',\n  \"workflow\": wf.get('name') or '(unknown)',\n  \"workflow_id\": t.workflowId or '',\n  \"task\": t.name or '(unnamed)',\n  \"task_id\": t.id or '',\n  \"via_action\": sweep.action,\n  \"method\": (inp.get('method') or 'GET') | upper,\n  \"shape\": 'absolute URL' if probe.startswith('http') else ('relative traversal' if '../' in probe else 'relative path'),\n  \"cw_module\": segs[-2] if (segs | length) > 1 else '',\n  \"cw_action\": leaf,\n  \"writes\": not is_read,\n  \"fails_loud\": inp.get('require_2xx_status') is not false,\n  \"loops\": (loop_cfg.get('items') or '') | string | length > 0,\n  \"endpoint\": clean\n}) -%}\n{%- endif -%}\n{%- endfor -%}\n{%- endfor -%}\n{%- set lim = CTX.task_limit | d(1000) | int -%}\n{%- set ncw = (CTX.cw_tasks or []) | length -%}\n{%- set nhttp = (CTX.http_tasks or []) | length -%}\n{{ {\n  \"findings\": findings | sort(attribute='workflow'),\n  \"total\": findings | length,\n  \"workflows\": findings | map(attribute='workflow_id') | unique | list | length,\n  \"writes\": findings | selectattr('writes') | list | length,\n  \"loops\": findings | selectattr('loops') | list | length,\n  \"silent_failures\": findings | rejectattr('fails_loud') | list | length,\n  \"cw_scanned\": ncw,\n  \"http_scanned\": nhttp,\n  \"limit\": lim,\n  \"truncated\": ncw >= lim or nhttp >= lim\n} }}"}},"join":1,"retry":null,"mockInput":{},"isMocked":false,"humanSecondsSaved":0,"timeout":600,"transitionMode":"FOLLOW_FIRST","publishResultAs":"audit","runAsOrgId":null,"with":null,"securitySchema":{},"action":{"id":"@@@action_ref2@@@"},"next":[],"packOverrides":[]},{"id":"@@@workflow_task_id_ref3@@@","input":{"fields":null,"operation":null,"raw_query":"query CwGenericTasks($actionId: ID!, $limit: Int!) {\n  workflowTasks(where: { actionId: $actionId }, limit: $limit) {\n    id\n    name\n    workflowId\n    input\n    with { items }\n    workflow {\n      id\n      name\n      orgId\n    }\n  }\n}","operation_type":null,"variable_values":{"limit":"{{ CTX.task_limit | d(1000) | int }}","actionId":"{{ CTX.cw_actions | map(attribute='id') | first }}"}},"join":1,"retry":null,"mockInput":{},"isMocked":false,"humanSecondsSaved":0,"timeout":600,"transitionMode":"FOLLOW_FIRST","publishResultAs":"cw_tasks","runAsOrgId":null,"with":null,"securitySchema":{},"action":{"id":"@@@action_ref3@@@"},"next":[{"do":["@@@workflow_task_id_ref6@@@"],"id":"@@@transition_id_ref2@@@","publish":[],"when":"{{ SUCCEEDED }}"}],"packOverrides":[]},{"id":"@@@workflow_task_id_ref4@@@","input":{"fields":null,"operation":null,"raw_query":"query HttpTasks($actionId: ID!, $limit: Int!) {\n  workflowTasks(where: { actionId: $actionId }, limit: $limit) {\n    id\n    name\n    workflowId\n    input\n    with { items }\n    workflow {\n      id\n      name\n      orgId\n    }\n  }\n}","operation_type":null,"variable_values":{"limit":"{{ CTX.task_limit | d(1000) | int }}","actionId":"{{ CTX.http_actions | map(attribute='id') | first }}"}},"join":1,"retry":null,"mockInput":{},"isMocked":false,"humanSecondsSaved":0,"timeout":600,"transitionMode":"FOLLOW_FIRST","publishResultAs":"http_tasks","runAsOrgId":null,"with":null,"securitySchema":{},"action":{"id":"@@@action_ref3@@@"},"next":[{"do":["@@@workflow_task_id_ref2@@@"],"id":"@@@transition_id_ref3@@@","publish":[],"when":"{{ SUCCEEDED }}"}],"packOverrides":[]},{"id":"@@@workflow_task_id_ref5@@@","input":{"fields":null,"operation":null,"raw_query":"query ResolveCwAction($ref: String!) {\n  actions(search: { ref: { _ilike: $ref } }, limit: 5) {\n    id\n    ref\n    name\n  }\n}","operation_type":